FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy and install dependencies
COPY package*.json ./
RUN npm install -g pm2 && npm install

# Copy the rest of the code
COPY . .

# Set environment to use the correct .env file
ENV NODE_ENV=docker

# Expose the port your app runs on
EXPOSE 3000

# Start the app using PM2 for better process management (optional)
CMD ["node", "server.js"]
