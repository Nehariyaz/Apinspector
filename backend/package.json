{
  "name": "express_demo",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "NODE_ENV=test jest --forceExit --detectOpenHandles --setupFiles dotenv/config",
    "test:watch": "NODE_ENV=test jest --watch --forceExit --detectOpenHandles --setupFiles dotenv/config",
    "migrate": "npx knex migrate:latest --env test",
    "rollback": "npx knex migrate:rollback --env test",
    "start": "node server.js",
    "db:migrate": "npx sequelize-cli db:migrate --config config/config.js",
    "db:seed": "npx sequelize-cli db:seed:all --config config/config.js",
    "db:rollback": "npx sequelize-cli db:migrate:undo --config config/config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.5",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "connect-session-sequelize": "^7.1.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.0",
    "otp-generator": "^4.0.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "pgpass": "^1.0.5",
    "sequelize": "^6.37.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.1.0"
  }
}
