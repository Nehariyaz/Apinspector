PORT=4000  # Use a different port for testing

# Test Database Configuration (Use an isolated test DB)
DB_NAME=testdb
DB_USER=testuser
DB_PASS=testpass # Ensure consistency with your main env file
DB_HOST=localhost
DB_DIALECT=postgres
DB_PORT=5432

# Secrets (You can use dummy values for testing)
JWT_SECRET=test_secret_key
SESSION_SECRET=test_session_secret

# Email Configuration (Use a dummy email)
EMAIL_USER=test@example.com
EMAIL_PASS=testpassword

# Google reCAPTCHA (Optional for testing)
RECAPTCHA_SECRET_KEY=test_recaptcha_secret

# Frontend Connection (Test frontend URL)
FRONTEND_URL=http://localhost:5174
